-a "~/Music/raw/urls.txt"

--extract-audio
-f "ba/b"
--audio-quality 0

--embed-metadata
--parse-metadata "playlist_index:%(track_number)s"
--parse-metadata "release_year:(?:(?P<meta_date>\d{4}))"

--embed-thumbnail
--convert-thumbnails jpg
--ppa "ThumbnailsConvertor+ffmpeg:-c:v mjpeg -vf crop=\"'if(gt(ih,iw),iw,ih)':'if(gt(ih,iw),iw,ih)'\""

-o "~/Music/raw/%(album,playlist,'Singles')s/%(track_number,playlist_index)02d - %(title)s.%(ext)s"

--windows-filenames
--no-mtime
--continue

--download-archive "~/Music/raw/historial.txt"
