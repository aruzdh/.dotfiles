theme = lumon
custom-shader = ./shaders/cursor_blaze.glsl
custom-shader = ./shaders/tft.glsl
custom-shader = ./shaders/bloom.glsl
custom-shader = ./shaders/bettercrt.glsl

background-opacity = 1
background-blur = false

font-family = IoskeleyMono Nerd Font
font-size = 16
font-feature = liga, ss02, ss05, ss07, ss08, ss11, ss14

cursor-style = underline
cursor-style-blink = true
mouse-hide-while-typing = true

macos-titlebar-style = hidden
macos-window-shadow = false
macos-icon = "retro"

window-padding-x = 5
window-padding-y = 5
window-width = 9999
window-height = 9999

link-url = true
